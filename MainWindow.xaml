<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp1"
        Title="Фігури Ліссажу" Height="400" Width="650">

    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Амплітуда X (Ax):"/>
            <TextBox Text="{Binding Ax}" Margin="0,0,0,5"/>

            <TextBlock Text="Амплітуда Y (Ay):"/>
            <TextBox Text="{Binding Ay}" Margin="0,0,0,5"/>

            <TextBlock Text="Частота X (Fx):"/>
            <TextBox Text="{Binding Fx}" Margin="0,0,0,5"/>

            <TextBlock Text="Частота Y (Fy):"/>
            <TextBox Text="{Binding Fy}" Margin="0,0,0,5"/>

            <TextBlock Text="Крок часу:"/>
            <TextBox Text="{Binding TimeStep}" Margin="0,0,0,10"/>

            <TextBlock Text="{Binding PhiX, StringFormat='Фаза X: {0}'}"/>
            <Slider Minimum="0" Maximum="360" Value="{Binding PhiX}" Margin="0,0,0,5"/>

            <TextBlock Text="{Binding PhiY, StringFormat='Фаза Y: {0}'}"/>
            <Slider Minimum="0" Maximum="360" Value="{Binding PhiY}" Margin="0,0,0,15"/>

            <Button Content="Побудувати фігуру" Command="{Binding DrawCommand}" Height="30"/>
        </StackPanel>

        <Canvas Grid.Column="1" Background="White" ClipToBounds="True" Margin="0,0,-96,-669">
            <Polyline Points="{Binding FigurePoints}" Stroke="Blue" StrokeThickness="2"/>
        </Canvas>
    </Grid>
</Window>